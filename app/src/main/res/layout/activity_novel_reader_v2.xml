<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- 小说内容视图 (左右翻页模式) -->
    <org.skepsun.kototoro.reader.novel.NovelReaderView
        android:id="@+id/readerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/colorSurface" />

    <!-- 小说内容视图 (上下滚动模式) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/continuousScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:scrollbars="none"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeNovelReaderView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />



    <!-- 信息栏（复用漫画阅读器） -->
    <org.skepsun.kototoro.reader.ui.ReaderInfoBarView
        android:id="@+id/infoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="6dp"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 顶部工具栏（复用漫画阅读器） -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/m3_card_elevated_elevation"
        app:elevation="@dimen/m3_card_elevated_elevation"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/m3_card_elevated_elevation"
            app:elevation="@dimen/m3_card_elevated_elevation"
            app:popupTheme="@style/ThemeOverlay.Kototoro" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 底部工具栏（复用 ReaderActionsView） -->
    <com.google.android.material.dockedtoolbar.DockedToolbarLayout
        android:id="@+id/toolbar_docked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fitsSystemWindows="false"
        app:cardBackgroundColor="?colorSurfaceContainer"
        app:layout_insetEdge="bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <org.skepsun.kototoro.reader.ui.ReaderActionsView
                android:id="@+id/actionsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?actionBarSize" />
                
        </LinearLayout>

    </com.google.android.material.dockedtoolbar.DockedToolbarLayout>

    <include layout="@layout/view_immersive_space_switcher_fab" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
