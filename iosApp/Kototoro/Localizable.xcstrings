    "自定义空间": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom spaces"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自定義空間"
          }
        }
      }
    },
    "自定义空间按内容类型、来源语言与来源类型划定范围（各项之间为“且”，同一项内为“或”，留空不限），与 Android 共用同一份数据。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom spaces filter by content type, source language, and source type. Each group must match; within a group, any option matches. Leave empty for no restriction. Spaces share data with Android."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自定義空間按內容類型、來源語言與來源類型劃定範圍（各項之間為“且”，同一項內為“或”，留空不限），與 Android 共用同一份資料。"
          }
        }
      }
    },
    "至少 %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
