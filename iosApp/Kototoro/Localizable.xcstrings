            "state": "translated",
            "value": "關閉後使用模糊封面作為頁面背景。"
          }
        }
      }
    },
    "关闭后可从屏幕边缘滑动翻页，点按画面显示控件后使用返回按钮退出。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When disabled, swipe from the edge to turn pages. Tap the screen to show controls and use the back button to exit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後可從螢幕邊緣滑動翻頁，點按畫面顯示控制元件後使用返回按鈕退出。"
          }
        }
      }
    },
    "关闭应用锁": {
      "localizations": {
        "en": {
          "stringUnit": {
