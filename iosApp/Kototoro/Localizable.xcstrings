    "点击屏幕边缘翻页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap screen edges to turn pages"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選螢幕邊緣翻頁"
          }
        }
      }
    },
    "点右上角“+”导入 CBZ/ZIP 漫画，或 EPUB、TXT 小说。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “+” at the top right to import CBZ/ZIP manga or EPUB/TXT novels."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點右上角“+”匯入 CBZ/ZIP 漫畫，或 EPUB、TXT 小說。"
          }
        }
      }
    },
    "点左侧红色按钮或左滑分类可删除；点“调整顺序”后拖动右侧手柄排序。隐藏的分类仍可在整理分类中使用，作品仍出现在“全部”中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the red button or swipe left on a category to delete it; tap “Reorder” and drag the handles to sort. Hidden categories can still be used when organizing, and their works still appear in “All”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點左側紅色按鈕或左滑分類可刪除；點“調整順序”後拖動右側手柄排序。隱藏的分類仍可在整理分類中使用，作品仍出現在“全部”中。"
          }
        }
      }
    },
    "点开作品可查看介绍，再关联到作品库中的作品，使用网站资料或开启进度追踪。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a work to see its description, then link it to a library work to use the site's info or track progress."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點開作品可檢視介紹，再關聯到作品庫中的作品，使用網站資料或開啟進度追蹤。"
          }
        }
      }
    },
    "点开作品可查看介绍，通过全局搜索或作品库选择对应作品，再使用网站资料或开启进度追踪。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a work to view its description. Find the matching work using global search or the library, then use site metadata or enable progress tracking."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點開作品可檢視介紹，透過全域性搜尋或作品庫選擇對應作品，再使用網站資料或開啟進度追蹤。"
          }
        }
      }
    },
    "点选一份备份查看内容并合并恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a backup to review and merge its contents."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選一份備份檢視內容併合並恢復。"
          }
        }
      }
    },
    "点选要保留的那一部。合并会把收藏分类、笔记、统计和追踪并入保留的作品，并保留读得最远的进度。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the entry to keep. Merging moves categories, notes, statistics and tracking into it and keeps the furthest reading progress."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選要保留的那一部。合併會把收藏分類、筆記、統計和追蹤併入保留的作品，並保留讀得最遠的進度。"
          }
        }
      }
    },
