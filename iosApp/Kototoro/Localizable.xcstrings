        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”的值不被此來源接受。"
          }
        }
      }
    },
    "“%@”：%@ 条记录，以合并方式恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: %2$@ records, to be merged on restore."
